      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Cybernetics is a systems discipline uniquely suited to wicked challenges because it forefronts information and purpose for guiding design and action in today’s complex entanglements of natural, technological, and social systems.",
              "link": null
            },
            "annotations": {
              "bold": false,
