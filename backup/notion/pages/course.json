      "paragraph": {
        "rich_text": [
          {
            "type": "text",
            "text": {
              "content": "Students will be introduced to applying Cybernetics as a means of exploring their own interests in any of a wide range of wicked challenges. Practices explored in the course will help students to articulate and model both the domain of their interest (subject and scope) as well as their concerns (personal intentions and desired outcomes).",
              "link": null
            },
