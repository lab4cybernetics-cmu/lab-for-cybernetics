          "Bio": {
            "id": "%3C_aT",
            "type": "rich_text",
            "rich_text": [
              {
                "type": "text",
                "text": {
                  "content": "Narayan is an interaction designer finishing his Master’s at Carnegie Mellon University, working across hardware, digital interfaces, and tools. His practice is grounded in building, using prototypes not just to test ideas, but to define problems, make decisions, and move toward working systems.\n\nHe has been with the Lab for Cybernetics for close to 2 years and he lead work on the lab’s digital infrastructure across product design, front-end development, and content systems. He designed and built the lab website, structured a Notion-backed CMS, developed documentation for handoff and maintenance, and helped build a practitioner-scholar matching platform. His work focuses on turning complex research, people, and cybernetics concepts into connected digital systems that are easier to navigate, update, and build on.",
                  "link": null
                },
                "annotations": {
                  "bold": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false,
                  "code": false,
                  "color": "default"
                },
                "plain_text": "Narayan is an interaction designer finishing his Master’s at Carnegie Mellon University, working across hardware, digital interfaces, and tools. His practice is grounded in building, using prototypes not just to test ideas, but to define problems, make decisions, and move toward working systems.\n\nHe has been with the Lab for Cybernetics for close to 2 years and he lead work on the lab’s digital infrastructure across product design, front-end development, and content systems. He designed and built the lab website, structured a Notion-backed CMS, developed documentation for handoff and maintenance, and helped build a practitioner-scholar matching platform. His work focuses on turning complex research, people, and cybernetics concepts into connected digital systems that are easier to navigate, update, and build on.",
                "href": null
              }
            ]
          },
